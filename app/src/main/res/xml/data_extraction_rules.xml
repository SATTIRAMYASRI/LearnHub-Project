<?xml version="1.0" encoding="utf-8"?>
<!-- Keystore-backed keys are not restored on another device, so never back up the encrypted token file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_auth.xml" />
    </device-transfer>
</data-extraction-rules>
