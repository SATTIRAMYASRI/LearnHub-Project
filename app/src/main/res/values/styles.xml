<?xml version="1.0" encoding="utf-8"?>
<!-- Single source of truth for all widget/text styles. Screens must use these, not inline attributes. -->
<resources>
    <style name="TextAppearance.LearnHub.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LearnHub.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LearnHub.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.LearnHub.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.LearnHub.Error" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="TextAppearance.LearnHub.StatusCompleted" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/success</item>
    </style>

    <style name="TextAppearance.LearnHub.StatusPending" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/pending</item>
    </style>

    <style name="Widget.LearnHub.Button" parent="Widget.Material3.Button" />

    <style name="Widget.LearnHub.Button.Tonal" parent="Widget.Material3.Button.TonalButton" />

    <style name="Widget.LearnHub.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <style name="Widget.LearnHub.ProgressBar" parent="Widget.Material3.LinearProgressIndicator" />

    <style name="Widget.LearnHub.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_md</item>
    </style>

    <style name="Widget.LearnHub.Loading" parent="Widget.Material3.CircularProgressIndicator">
        <item name="android:indeterminate">true</item>
    </style>
</resources>
